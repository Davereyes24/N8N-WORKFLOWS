    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ─── n8n Code Node: \"Run Once for Each Item\" ───\n// Input shape per item: { activity: [...], total }\n//\n// Configure these:\nconst EXPECTED_HOURS_PER_DAY = 9;\nconst ALLOWED_BREAK_MINUTES  = 60;\n\n// ─── Parse Rest Days from sheet ─────────────────\n// Expected format: \"Sunday, Monday\" or \"Sunday\" etc.\nconst restDaysRaw = $('Get row(s) in sheet2').item.json['Rest Days'] || '';\nconst REST_DAY_NAMES = new Set(\n  restDaysRaw\n    .split(',')\n    .map(d => d.trim().toLowerCase())\n    .filter(d => d.length > 0)\n);\n\nconst DAY_NAMES = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];\n\n// ─── PH Public Holidays 2026 ────────────────────\n// Note: EDSA Anniversary (Feb 25) is a special WORKING day → not included.\nconst PH_HOLIDAYS_2026 = new Set([\n  '2026-01-01', // New Year's Day\n  '2026-02-17', // Chinese New Year\n  '2026-03-16', // Davao City Day\n  '2026-03-20', // Eid al-Fitr\n  '2026-04-02', // Maundy Thursday\n  '2026-04-03', // Good Friday\n  '2026-04-04', // Black Saturday\n  '2026-04-09', // Day of Valor\n  '2026-05-01', // Labor Day\n  '2026-05-27', // Eid al-Adha\n  '2026-06-12', // Independence Day\n  '2026-08-14', // Kadayawan Festival (Davao City)\n  '2026-08-21', // Ninoy Aquino Day\n  '2026-08-31', // National Heroes Day\n  '2026-11-01', // All Saints' Day\n  '2026-11-02', // All Souls' Day\n  '2026-11-30', // Bonifacio Day\n  '2026-12-08', // Feast of the Immaculate Conception of Mary\n  '2026-12-24', // Christmas Eve\n  '2026-12-25', // Christmas Day\n  '2026-12-30', // Rizal Day\n  '2026-12-31', // Last Day of the Year\n]);\n\n// ─── Helpers ────────────────────────────────────\n\nfunction isRestDay(dateStr) {\n  const [y, m, d] = dateStr.split('-').map(Number);\n  const dayIndex = new Date(y, m - 1, d).getDay();\n  return REST_DAY_NAMES.has(DAY_NAMES[dayIndex]);\n}\n\nfunction isHoliday(dateStr) {\n  return PH_HOLIDAYS_2026.has(dateStr);\n}\n\nfunction fmtHM(seconds) {\n  if (!seconds || seconds <= 0) return '0h 0m';\n  const h = Math.floor(seconds / 3600);\n  const m = Math.floor((seconds % 3600) / 60);\n  return `${h}h ${m}m`;\n}\n\nfunction fmtDecimal(seconds) {\n  return +(seconds / 3600).toFixed(2);\n}\n\n// ─── Get the activity array ─────────────────────\n\nconst json = $input.item.json;\nconst records = json.activity || json.data || json.records || json.items || [];\n\nif (!records.length) {\n  return {\n    json: {\n      user: '',\n      userId: null,\n      groups: [],\n      dateRange: '',\n      reportsTo: '',\n      workingDays: 0,\n      daysPresent: 0,\n      daysAbsent: 0,\n      totalUndertime: '0h 0m',\n      totalUndertimeSec: 0,\n      totalOverbreaks: '0h 0m',\n      totalOverbreakSec: 0,\n      totalBreakMinutes: 0,\n      totalHoursWorked: '0h 0m',\n      totalHoursWorkedDec: 0,\n      totalHoursElapsed: '0h 0m',\n    }\n  };\n}\n\n// ─── User info from first record ────────────────\n\nconst firstRec   = records[0];\nconst userName   = firstRec.user || '';\nconst userId     = firstRec.userId || null;\nconst userGroups = firstRec.groups || [];\nconst reportsTo  = userGroups.length > 0 ? userGroups[0] : '';\n\nconst expectedDailySec = EXPECTED_HOURS_PER_DAY * 3600;\nconst allowedBreakSec  = ALLOWED_BREAK_MINUTES * 60;\n\n// ─── Sort by date ascending ─────────────────────\n\nconst sorted = [...records].sort((a, b) => a.date.localeCompare(b.date));\n\n// ─── Sum everything ─────────────────────────────\n\nlet workingDays       = 0;\nlet daysPresent       = 0;\nlet daysAbsent        = 0;\nlet totalWorkedSec    = 0;\nlet totalUndertimeSec = 0;\nlet totalOverbreakSec = 0;\nlet totalBreakMinAll  = 0;\nlet totalElapsedSec   = 0;\n\nfor (const rec of sorted) {\n  if (isRestDay(rec.date) || isHoliday(rec.date)) continue; // skip rest days & holidays\n\n  workingDays++;\n\n  const hasActivity = rec.firstActivity !== null && rec.totalTime > 0;\n\n  if (!hasActivity) {\n    daysAbsent++;\n    totalUndertimeSec += expectedDailySec;\n    continue;\n  }\n\n  daysPresent++;\n\n  const elapsedSec   = Math.max(0, (new Date(rec.lastActivity) - new Date(rec.firstActivity)) / 1000);\n  const breakSec     = Math.max(0, elapsedSec - rec.totalTime);\n  const overbreakSec = Math.max(0, breakSec - allowedBreakSec);\n  const undertimeSec = Math.max(0, expectedDailySec - rec.totalTime);\n\n  totalElapsedSec   += elapsedSec;\n  totalWorkedSec    += rec.totalTime;\n  totalBreakMinAll  += Math.round(breakSec / 60);\n  totalOverbreakSec += overbreakSec;\n  totalUndertimeSec += undertimeSec;\n}\n\nconst dateStart = sorted[0].date;\nconst dateEnd   = sorted[sorted.length - 1].date;\n\n// ─── Return ─────────────────────────────────────\n\nreturn {\n  json: {\n    user: userName,\n    userId,\n    groups: userGroups,\n    dateRange: `${dateStart} → ${dateEnd}`,\n    reportsTo,\n    workingDays,\n    daysPresent,\n    daysAbsent,\n    totalUndertime: fmtHM(totalUndertimeSec),\n    totalUndertimeSec,\n    totalOverbreaks: fmtHM(totalOverbreakSec),\n    totalOverbreakSec,\n    totalBreakMinutes: totalBreakMinAll,\n    totalHoursWorked: fmtHM(totalWorkedSec),\n    totalHoursWorkedDec: fmtDecimal(totalWorkedSec),\n    totalHoursElapsed: fmtHM(totalElapsedSec),\n  }\n};\n"
      },

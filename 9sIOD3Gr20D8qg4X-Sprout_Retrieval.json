        "responses": {
          "values": [
            {
              "content": "=COA Certificate of Attendance Approval Request\n\nPrompt:\n\nGiven the below request details and activity tracking data, please assist in determining the approval or denial of the COA certificate of attendance request.\n\nRequest Details:\n- Request ID: {{ $('request').item.json.id }}\n- Internal Request ID: {{ $('request').item.json.requestId }}\n- Full Name: {{ $('request').item.json.fullName }}\n- Request Type: {{ $('request').item.json.type }}\n- Reason for Request: \n\nActivTrak Activity Data:\n- User Name: {{ $json.user_name }}\n- Local Date: {{ $json.local_date }}\n- First Activity Time: {{ $json.first_activity_datetime }}\n- Last Activity Time: {{ $json.last_activity_datetime }}\n\nTask:\n1. Verify the user's activity using ActivTrak data as a basis for deciding on the approval of the COA certificate.\n2. Consider whether the recorded activity aligns with the attendance requirements stated in the request.\n3. Based on the analysis, determine if the request should be approved or denied.\n\nOutput:\nPlease provide the decision in the following JSON format:\n\n{\n  \"requestDetail\": {\n    \"requestId\": \"{{ $('request').item.json.requestId }}\",\n    \"fullName\": \"{{ $('request').item.json.fullName }}\",\n    \"type\": \"{{ $('request').item.json.type }}\",\n    \"reason\": \"{{ $('request').item.json.reason }}\"\n  },\n  \"activTrakData\": {\n    \"userName\": \"{{ $json.user_name }}\",\n    \"localDate\": \"{{ $json.local_date }}\",\n    \"firstActivityDatetime\": \"{{ $json.first_activity_datetime }}\",\n    \"lastActivityDatetime\": \"{{ $json.last_activity_datetime }}\"\n  },\n  \"decision\": {\n    \"status\": \"approved/denied\", // choose 'approved' or 'denied' based on your analysis\n    \"reasoning\": \"Provide a detailed reasoning for the decision here including whether the recorded activity supports the request for attendance.\"\n  }\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"requestDetail\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"requestId\": {\n          \"type\": \"string\"\n        },\n        \"fullName\": {\n          \"type\": \"string\"\n        },\n        \"type\": {\n          \"type\": \"string\"\n        },\n        \"reason\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\"requestId\", \"fullName\", \"type\", \"reason\"],\n      \"additionalProperties\": false\n    },\n    \"activTrakData\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"userName\": {\n          \"type\": \"string\"\n        },\n        \"localDate\": {\n          \"type\": \"string\",\n          \"format\": \"date\"\n        },\n        \"firstActivityDatetime\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"lastActivityDatetime\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        }\n      },\n      \"required\": [\"userName\", \"localDate\", \"firstActivityDatetime\", \"lastActivityDatetime\"],\n      \"additionalProperties\": false\n    },\n    \"decision\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\"approved\", \"denied\"]\n        },\n        \"reasoning\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\"status\", \"reasoning\"],\n      \"additionalProperties\": false\n    }\n  },\n  \"required\": [\"requestDetail\", \"activTrakData\", \"decision\"],\n  \"additionalProperties\": false\n}"
            }
          }

        "jsCode": "const contact = $input.first().json;\nconst customFields = Array.isArray(contact.custom_fields) ? contact.custom_fields : [];\nconst dateField = customFields.find((field) => String(field?.id) === '315');\nconst onboardingDate = String(dateField?.content ?? '').trim();\nconst emails = Array.isArray(contact.email_addresses) ? contact.email_addresses : [];\nconst email = String(emails.find((entry) => entry?.field === 'EMAIL1')?.email ?? emails[0]?.email ?? '').trim().toLowerCase();\nconst externalId = String(contact.id ?? '').trim();\nlet skipReason = null;\nif (!externalId) skipReason = 'missing_contact_id';\nelse if (!onboardingDate) skipReason = 'missing_onboarding_date';\nelse if (email.includes('@outsourceddoers.com') || email.includes('@doneverse.com') || email.startsWith('test')) skipReason = 'excluded_contact';\nreturn [{ json: { external_id: externalId, onboarding_date: onboardingDate || null, skip_reason: skipReason } }];"
      },
